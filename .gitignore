# ==========================================
# CHUNG (Node & Dependencies)
# ==========================================
# Bỏ qua node_modules ở thư mục gốc và tất cả các thư mục con
node_modules/
*/node_modules/

# Node logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ==========================================
# BIẾN MÔI TRƯỜNG & BẢO MẬT (Security)
# ==========================================
# Tuyệt đối không đưa các file chứa key, password lên git
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem

# Chú ý: Cho phép commit các file template để team biết cần điền biến gì
!.env.example
!.env.template

# ==========================================
# BACKEND (NestJS - devwiki-api)
# ==========================================
# Thư mục build của NestJS
devwiki-api/dist/
devwiki-api/coverage/
devwiki-api/.nest/
devwiki-api/.nyc_output/

# ==========================================
# FRONTEND (React Vite - devwiki-web)
# ==========================================
