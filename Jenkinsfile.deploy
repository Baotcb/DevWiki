@Library('devwiki-shared') _

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name:        'DEPLOY_ENV',
            choices:     ['dev', 'prod'],
            description: 'Moi truong can deploy (dev → branch develop | prod → branch main/master)'
        )
        booleanParam(
            name:         'CREATE_DB_BACKUP',
            defaultValue: false,
            description:  'Tao file backup MongoDB (vXX.archive.gz) sau khi deploy xong'
        )
    }

    triggers {
        githubPush()
    }

    environment {
        IMAGE_API  = 'devwiki-api'
        IMAGE_WEB  = 'devwiki-web'
        DOCKER_TAG = "v${env.BUILD_ID}"
    }

    stages {
        stage('Prepare') {
            steps {
                script {
                    def branch = env.GIT_BRANCH ?: env.BRANCH_NAME ?: ''

                    def isManual = currentBuild
                        .getBuildCauses('hudson.model.Cause$UserIdCause').size() > 0

                    if (isManual) {
                        env.EFFECTIVE_ENV = params.DEPLOY_ENV
                        echo "==> [DEPLOY] Trigger: MANUAL | Env tu param: ${env.EFFECTIVE_ENV}"
                    } else {
                        if (branch == 'develop' || branch.endsWith('/develop')) {
                            env.EFFECTIVE_ENV = 'dev'
                        } else if (branch =~ /^(origin\/)?(main|master)$/) {
                            env.EFFECTIVE_ENV = 'prod'
                        } else {
                            error "[DEPLOY] Webhook tu branch '${branch}' khong the tu dong xac dinh env. " +
                                  "Chi ho tro: develop → dev | main/master → prod"
                        }
                        echo "==> [DEPLOY] Trigger: AUTO (Webhook) | Branch: ${branch} | Env tu dong: ${env.EFFECTIVE_ENV}"
                    }

                    echo "==> [DEPLOY] Build ${env.BUILD_ID} | Tag: ${env.DOCKER_TAG} | Env: ${env.EFFECTIVE_ENV}"
                }
            }
        }

        stage('Build Docker Images') {
            parallel {
                stage('Build API') {
                    steps {
                        sh "docker build -t ${IMAGE_API}:${DOCKER_TAG} -t ${IMAGE_API}:latest --label build.id=${BUILD_ID} devwiki-api/"
                    }
                }
                stage('Build Web') {
                    steps {
                        sh "docker build -t ${IMAGE_WEB}:${DOCKER_TAG} -t ${IMAGE_WEB}:latest --label build.id=${BUILD_ID} devwiki-web/"
                    }
                }
            }
        }

        stage('Package Docker Images') {
            steps {
                sh '''
                    set -eu
                    docker save "$IMAGE_API:$DOCKER_TAG" | gzip > "$WORKSPACE/${IMAGE_API}-${DOCKER_TAG}.tar.gz"
                    docker save "$IMAGE_WEB:$DOCKER_TAG" | gzip > "$WORKSPACE/${IMAGE_WEB}-${DOCKER_TAG}.tar.gz"
                '''
            }
        }

        stage('Deploy To Target Server') {
            steps {
                script {
                    def cfg    = envConfig(env.EFFECTIVE_ENV)
                    def branch = env.GIT_BRANCH ?: env.BRANCH_NAME ?: ''

                    def allowed = cfg.allowedBranches.any { b -> branch == b || branch.endsWith("/${b}") }
                    if (!allowed) {
                        error "[DEPLOY] Branch '${branch}' khong duoc phep deploy len '${env.EFFECTIVE_ENV}'. Allowed: ${cfg.allowedBranches}"
                    }

                    if (cfg.requireApproval) {
                        input(
                            message: " Xac nhan deploy ${env.DOCKER_TAG} len PRODUCTION?",
                            ok:      'Deploy'
                        )
                    }

                    lock(cfg.lockName) {
                        devwikiDeploy(
                            deployEnv:    env.EFFECTIVE_ENV,
                            imageApi:     IMAGE_API,
                            imageWeb:     IMAGE_WEB,
                            tag:          DOCKER_TAG,
                            createBackup: params.CREATE_DB_BACKUP
                        )
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'rm -f "$WORKSPACE"/devwiki-api-v*.tar.gz "$WORKSPACE"/devwiki-web-v*.tar.gz "$WORKSPACE"/remote_deploy.sh || true'
        }
        success {
            echo "==> [DEPLOY] Thanh cong: ${env.DOCKER_TAG} → ${env.EFFECTIVE_ENV}"
        }
        failure {
            echo "==> [DEPLOY] That bai: ${env.DOCKER_TAG} → ${env.EFFECTIVE_ENV}"
        }
    }
}
