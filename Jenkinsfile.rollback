@Library('devwiki-shared') _

pipeline {
    agent any

    options {
        disableConcurrentBuilds()
    }

    parameters {
        choice(
            name:        'DEPLOY_ENV',
            choices:     ['dev', 'prod'],
            description: 'Moi truong can rollback (dev | prod)'
        )
        string(
            name:         'ROLLBACK_VERSION',
            defaultValue: '',
            description:  'Version can rollback, vi du: v36'
        )
        booleanParam(
            name:         'USE_LATEST_ENV',
            defaultValue: false,
            description:  'Ghi de env moi nhat thay vi giu env cu cua version do'
        )
        booleanParam(
            name:         'RESTORE_DATABASE',
            defaultValue: false,
            description:  'Phuc hoi MongoDB tu ban backup da luu truoc do'
        )
        string(
            name:         'DATABASE_BACKUP_VERSION',
            defaultValue: '',
            description:  'Version backup MongoDB can restore, vi du: v36'
        )
    }

    environment {
        IMAGE_API = 'devwiki-api'
        IMAGE_WEB = 'devwiki-web'
    }

    stages {
        stage('Prepare & Validate') {
            steps {
                script {
                    env.EFFECTIVE_ENV = params.DEPLOY_ENV

                    if (!params.ROLLBACK_VERSION?.trim()) {
                        error('[ROLLBACK] ROLLBACK_VERSION la bat buoc. Nhap tag can rollback, vi du: v36')
                    }
                    if (params.RESTORE_DATABASE && !params.DATABASE_BACKUP_VERSION?.trim()) {
                        error('[ROLLBACK] Da chon RESTORE_DATABASE nhung chua nhap DATABASE_BACKUP_VERSION')
                    }

                    echo "==> [ROLLBACK] Env        : ${env.EFFECTIVE_ENV}"
                    echo "==> [ROLLBACK] Target     : ${params.ROLLBACK_VERSION}"
                    echo "==> [ROLLBACK] Env mode   : ${params.USE_LATEST_ENV ? 'Ghi de env moi nhat' : 'Giu nguyen env cu'}"
                    echo "==> [ROLLBACK] Restore DB : ${params.RESTORE_DATABASE ? params.DATABASE_BACKUP_VERSION : 'Khong'}"
                }
            }
        }

        stage('Rollback On Target Server') {
            steps {
                script {
                    def cfg = envConfig(env.EFFECTIVE_ENV)

                    if (cfg.requireApproval) {
                        input(
                            message: "Xac nhan rollback ve ${params.ROLLBACK_VERSION} tren ${env.EFFECTIVE_ENV.toUpperCase()}?",
                            ok:      'Rollback'
                        )
                    }

                    lock(cfg.lockName) {
                        devwikiRollback(
                            deployEnv:             env.EFFECTIVE_ENV,
                            version:               params.ROLLBACK_VERSION,
                            imageApi:              IMAGE_API,
                            imageWeb:              IMAGE_WEB,
                            useLatestEnv:          params.USE_LATEST_ENV,
                            restoreDatabase:       params.RESTORE_DATABASE,
                            databaseBackupVersion: params.DATABASE_BACKUP_VERSION
                        )
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'rm -f "$WORKSPACE"/remote_rollback.sh || true'
        }
        success {
            echo "==> [ROLLBACK] Thanh cong: ${params.ROLLBACK_VERSION} → ${env.EFFECTIVE_ENV}"
        }
        failure {
            echo "==> [ROLLBACK] That bai khi rollback ve: ${params.ROLLBACK_VERSION} → ${env.EFFECTIVE_ENV}"
        }
    }
}
